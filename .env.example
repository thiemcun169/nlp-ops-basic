# Chép file này thành `.env` rồi sửa. KHÔNG commit `.env` (đã nằm trong .gitignore).
#     cp .env.example .env
#
# Mọi dòng dưới đây đều CÓ THỂ để nguyên: hệ thống chạy được với toàn bộ mặc định.
# Chỉ sửa khi cổng bị chiếm, khi máy không có GPU, hoặc khi muốn bật phần LLM.

# ---------------------------------------------------------------------------
# 1. LLM đối chứng (tuỳ chọn)
# ---------------------------------------------------------------------------
# Không điền cũng chạy: backend `llm` sẽ báo chưa cấu hình, ba backend còn lại
# hoạt động bình thường.
# Key miễn phí, không cần thẻ ngân hàng: https://console.groq.com/keys
GROQ_API_KEY=

# Đổi sang nhà cung cấp khác theo chuẩn OpenAI (OpenRouter, Together, vLLM tự
# dựng...) chỉ cần đổi hai dòng này.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Để TRỐNG thì hệ thống tự dò model khả dụng theo thứ tự ưu tiên và nhớ lại.
# Ép một model cụ thể thì điền vào đây, ví dụ: groq/compound
LLM_MODEL=

# ---------------------------------------------------------------------------
# 2. Chọn model mặc định
# ---------------------------------------------------------------------------
# phobert-ner-gpu | phobert-ner-cpu | phobert-ner-local
# MÁY KHÔNG CÓ GPU: đặt DEFAULT_MODEL=phobert-ner-cpu và xoá khối `deploy` của
# service `triton` trong docker-compose.yml.
DEFAULT_MODEL=phobert-ner-gpu
# Model dùng khi Triton hỏng. Để trống là tắt cơ chế dự phòng.
FALLBACK_MODEL=phobert-ner-local

# ---------------------------------------------------------------------------
# 3. Cổng (chỉ sửa khi bị trùng với dịch vụ khác trên máy)
# ---------------------------------------------------------------------------
# Kiểm tra cổng đang bị chiếm:  ss -tlnp | grep -E '8080|8000|9490|3001'
API_PORT=8080
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
PROMETHEUS_PORT=9490
GRAFANA_PORT=3001

# ---------------------------------------------------------------------------
# 4. Hiệu năng
# ---------------------------------------------------------------------------
# Số kết nối mỗi thread giữ tới Triton. Tăng cao KHÔNG làm nhanh hơn --
# đã đo và thấy tệ hơn. Xem docs/TROUBLESHOOTING.md muc E03.
TRITON_CONCURRENCY=4
# Số luồng CPU cho backend chạy ONNX tại chỗ. Đặt cao thì chính tiến trình web
# bị đói CPU.
ONNX_LOCAL_THREADS=2
